# Copy this file outside the repository, replace every placeholder, restrict its file permissions,
# and pass it with: docker compose --env-file /secure/path/contractops.env -f docker-compose.prod.yml ...
CONTRACTOPS_IMAGE=registry.example/contractops-api@sha256:replace-with-image-digest
CONTRACTOPS_BIND_ADDRESS=127.0.0.1
CONTRACTOPS_API_PORT=8080
CONTRACTOPS_API_WORKERS=2
CONTRACTOPS_ALLOWED_HOSTS=api.contractops.example
CONTRACTOPS_FORWARDED_ALLOW_IPS=127.0.0.1
CONTRACTOPS_METRICS_BIND_ADDRESS=127.0.0.1
CONTRACTOPS_WORKER_METRICS_HOST_PORT=9101
CONTRACTOPS_SCHEDULER_METRICS_HOST_PORT=9102
CONTRACTOPS_INGESTION_METRICS_HOST_PORT=9103

CONTRACTOPS_DATABASE_URL=postgresql://contractops_app:replace-with-runtime-password@db.example/contractops?sslmode=verify-full
CONTRACTOPS_MIGRATION_DATABASE_URL=postgresql://contractops_admin:replace-with-migration-password@db.example/contractops?sslmode=verify-full
CONTRACTOPS_WORKER_DATABASE_URL=postgresql://contractops_worker:replace-with-worker-password@db.example/contractops?sslmode=verify-full
CONTRACTOPS_REDIS_URL=rediss://:replace-with-redis-password@redis.example:6380/0

CONTRACTOPS_JWT_SECRET=replace-with-at-least-32-random-characters
CONTRACTOPS_JWT_ISSUER=contractops
CONTRACTOPS_JWT_AUDIENCE=contractops-api

CONTRACTOPS_OBJECT_STORE_ENDPOINT=https://objects.example
CONTRACTOPS_OBJECT_STORE_ACCESS_KEY=replace-with-access-key
CONTRACTOPS_OBJECT_STORE_SECRET_KEY=replace-with-secret-key
CONTRACTOPS_OBJECT_STORE_BUCKET=contractops-production
CONTRACTOPS_OBJECT_STORE_SECURE=true

CONTRACTOPS_OTEL_SERVICE_NAME=contractops-api
CONTRACTOPS_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example/v1/traces

# Leave blank to disable Webhook delivery. When enabled, both values are required and HTTPS is enforced.
CONTRACTOPS_NOTIFICATION_WEBHOOK_URL=
CONTRACTOPS_NOTIFICATION_WEBHOOK_SECRET=

# Model assistance remains advisory-only and disabled by default.
CONTRACTOPS_DOCUMENT_MODEL_ASSISTANCE_ENABLED=false
CONTRACTOPS_DOCUMENT_MODEL_NAME=qwen-plus
CONTRACTOPS_MODEL_BASE_URL=https://model.example/v1

# Keep false unless every plaintext dependency is isolated by an equivalent trusted transport layer.
CONTRACTOPS_ALLOW_INSECURE_DEPENDENCIES=false
